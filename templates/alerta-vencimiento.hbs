<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
    .container { max-width: 600px; margin: 20px auto; padding: 20px; border: 1px solid #ddd; border-radius: 5px; }
    .header { background-color: #f4f4f4; padding: 10px; text-align: center; font-size: 24px; font-weight: bold; }
    .content { margin-top: 20px; }
    .footer { margin-top: 20px; font-size: 12px; text-align: center; color: #777; }
    .registro { border-bottom: 1px solid #eee; padding-bottom: 10px; margin-bottom: 10px; }
    .registro strong { color: #555; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      Sistema de Alertas <br/> 
      Concejo Municipal de Nilo - Cundinamarca
    </div>
    <div class="content">
      <h1>{{ titulo }}</h1>
      <p>Se han encontrado {{ cantidad }} registros que requieren atención inmediata:</p>

      {{#each registros}}
      <div class="registro">
        <strong>Radicado:</strong> {{ this.radicado }} <br/>
        <strong>Remitente:</strong> {{ this.remitente }} <br/>
        <strong>Tipo:</strong> {{ this.tipoSolicitud }} <br/>  
        <strong>Asunto:</strong> {{ this.asunto }} <br/>
        <strong>Vence el:</strong> {{ this.fechaVencimiento }}
      </div>
      {{/each}}

      <p>Por favor, tomar las acciones correspondientes.</p>
    </div>
    <div class="footer">
      Este es un correo generado automáticamente.
    </div>
  </div>
</body>
</html>